services:
  db:
    image: postgres:15-alpine
    container_name: fundschain-db
    environment:
      POSTGRES_DB: fundschain_db
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres123
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
      # Automatically initialize database schema on startup
      - ./backend/schema.sql:/docker-entrypoint-initdb.d/schema.sql

  backend:
    image: node:18-alpine
    container_name: fundschain-backend
    working_dir: /app
    volumes:
      - ./backend:/app
    ports:
      - "5000:5000"
    command: sh -c "npm install && npm run dev"
    depends_on:
      - db
    environment:
      - PORT=5000
      - DB_HOST=db
      - DB_PORT=5432
      - DB_NAME=fundschain_db
      - DB_USER=postgres
      - DB_PASSWORD=postgres123

  frontend:
    image: node:18-alpine
    container_name: fundschain-frontend
    working_dir: /app
    volumes:
      - ./frontend:/app
    ports:
      - "8080:8080"
    # Runs Vite server on port 8080 mapping directly to host
    command: sh -c "npm install && npm run dev -- --host"
    depends_on:
      - backend

volumes:
  pgdata: