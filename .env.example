# =========================================================================
# UNIFIED DATABASE POOL CONFIGURATION
# Supports local dev (Docker), staging (Neon), and production (Render/etc)
# =========================================================================

# System Standard Configurations
DATABASE_ID_TYPE=UUID
DEFAULT_CURRENCY=KES
SYSTEM_ENVIRONMENT=local-dev
NODE_ENV=development

# CORS Configuration:
# ==================
# The backend automatically configures CORS based on environment:
#   - Development (NODE_ENV != 'production'): Allows localhost:5173, :3000, :8080
#   - Staging/Production: MUST set FRONTEND_URL and ALLOWED_ORIGIN env vars
#
# FRONTEND_URL: Primary frontend origin (e.g., https://app.onrender.com)
# ALLOWED_ORIGIN: Fallback origin (for multi-domain or legacy support)

FRONTEND_URL=http://localhost:8080
ALLOWED_ORIGIN=http://localhost:8080

# DATABASE CONNECTION STRATEGY:
# For Local Dev (Docker):
#   - Leave DATABASE_URL unset
#   - Set DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD
#
# For Staging/Production (Neon.tech on Render):
#   - Set DATABASE_URL to your Neon connection string
#   - Leave DB_HOST, DB_PORT, etc. (they will be ignored)

# PostgreSQL Configuration - Local Docker (Used if DATABASE_URL is not set)
DB_HOST=db
DB_PORT=5432
DB_NAME=fundschain_db
DB_USER=postgres
DB_PASSWORD=your_secure_dev_password

# Neon.tech PostgreSQL - Staging/Production (Used if DATABASE_URL is set)
# DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-1.neon.tech/fundschain_db?sslmode=require

# Application Service Ports
PORT_TRAINEE_PORTAL=8080
PORT_CORE_API=5000